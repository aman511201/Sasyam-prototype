# ==============================================================================
# SASYAM (AGRIFARMER) FRONTEND CONFIGURATION & API KEYS
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named `.env` in the same directory (`sih_project/frontend/.env`).
# 2. In Vite, all client-side variables MUST start with the prefix `VITE_`.
# 3. Restart your dev server after modifying `.env` (`npm run dev`).
#
# NOTE: The platform is built to work immediately OUT OF THE BOX even if you leave
# optional keys blank (it includes OpenStreetMap tiles, Open-Meteo weather, and
# local Agronomy AI fallback data). Adding the keys below unlocks live cloud services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND FASTAPI SERVICE (Optional for local testing, Recommended for full stack)
# ------------------------------------------------------------------------------
# Point this to your running FastAPI backend server.
# Default local port: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. MAP & LOGISTICS ROUTING (Optional - Map already works with Free OSM Tiles)
# ------------------------------------------------------------------------------
# OpenRouteService API Key:
# Used for real-world highway route calculation, heavy-truck driving profiles,
# and turn-by-turn road coordinates between farm fields and warehouses.
# Get free key (2,000 requests/day): https://openrouteservice.org/dev/#/signup
VITE_OPENROUTESERVICE_API_KEY=

# Mapbox Access Token (Alternative for Mapbox satellite and traffic tiles):
# Get free token: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. AI & VISION / VOICE ASSISTANT (Optional - Enhances Kisan AI)
# ------------------------------------------------------------------------------
# Google Gemini API Key:
# Used for advanced LLM agronomy reasoning, vernacular voice intelligence,
# and AI leaf disease diagnosis image analysis.
# Get free key: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. WEATHER DATA (Optional - Defaults to Free Open-Meteo API)
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (Only needed if switching from Open-Meteo):
# Get free key: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# ------------------------------------------------------------------------------
# 5. INDIAN APMC MANDI & E-NAM MARKET DATA (Optional)
# ------------------------------------------------------------------------------
# Data.gov.in (OGD India) API Key:
# Used to fetch live wholesale prices from APMC markets across India (Agmarknet).
# Get free key: https://data.gov.in/
VITE_DATA_GOV_API_KEY=
